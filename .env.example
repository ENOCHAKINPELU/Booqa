# Used only by api/proxy/[...path].js (a serverless function) — never sent
# to the browser. Set these as Vercel project environment variables in
# production; for local `vercel dev`, copy this file to `.env`.

# HotelOps backend base URL — the proxy appends /booking-api/v1 itself.
HOTELOPS_API_BASE_URL=http://localhost:5000

# From `npm run create-booking-channel booqa` in the HotelOps backend —
# provisions this channel's row in booking_channels.
BOOQA_API_KEY=paste_the_generated_api_key_here
BOOQA_HMAC_SECRET=paste_the_generated_hmac_secret_here

# Flutterwave public key for the guest-facing inline checkout (separate
# from the backend's FLW_SECRET_KEY — this one is safe to ship to the
# browser, it's a publishable key by design).
VITE_FLW_PUBLIC_KEY=FLWPUBK_TEST-your_public_key

# Guest accounts — same physical Supabase Postgres instance as HotelOps,
# but connected as the narrowly-privileged `booqa_app` role (see
# backend/db/migrations/025_booqa_accounts.sql), never the HotelOps
# service-role key. Run that migration, then:
#   ALTER ROLE booqa_app WITH PASSWORD 'a-strong-secret-you-generate';
# and build this from that password + your Supabase project's connection
# host (Project Settings -> Database).
DATABASE_URL=postgresql://booqa_app:password@db.your-project-ref.supabase.co:5432/postgres

# Signs the guest session cookie — separate from HotelOps' JWT_ACCESS_SECRET
# and from BOOQA_HMAC_SECRET above. A leaked one should never grant either
# of the others.
BOOQA_GUEST_JWT_SECRET=change_me_booqa_guest_jwt_secret_minimum_32_chars

# Booqa's own transactional email — reuse the same MailerSend account as
# HotelOps or create a new one, your call.
MAILERSEND_API_KEY=your_mailersend_api_key
MAILERSEND_FROM_EMAIL=noreply@booqa.ng

# Booqa's own deployed URL, used to build verification/reset-password links
# in emails. http://localhost:5174 for local `vercel dev`.
PUBLIC_APP_URL=http://localhost:5174
